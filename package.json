{
  "name": "cuekoda",
  "productName": "CueKoda",
  "version": "0.6.0",
  "license": "AGPL-3.0-or-later",
  "description": "Préparation musicale pour DJ : BPM, grille, tonalité, structure, énergie, hot cues, boucles — export rekordbox, Traktor et M3U8",
  "main": "dist/main/main.js",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "cli": "npm run build && node dist/cli/cli.js",
    "test": "npm run build && node dist/test/run.js",
    "test:unit": "npm run build && node --test dist/test/unit.js",
    "test:regression": "npm run build && node dist/test/regression.js samples",
    "test:all": "npm run typecheck && npm run test:unit && npm test",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "preview": "npm run build && node dist/cli/cli.js samples --out cuekoda-out --preview dist/renderer/preview-data.js && node scripts/make-preview.mjs",
    "dist": "node scripts/fetch-ffmpeg.mjs && npm run build && electron-builder --mac --win",
    "dist:mac": "node scripts/fetch-ffmpeg.mjs && npm run build && electron-builder --mac",
    "dist:win": "node scripts/fetch-ffmpeg.mjs && npm run build && electron-builder --win",
    "eval": "npm run build && node dist/test/evaluate.js",
    "eval:compare": "npm run build && node dist/test/compare-evaluations.js",
    "benchmark:rhythm": "npm run build && node dist/test/rhythm-benchmark.js",
    "corpora:verify": "node scripts/verify-evaluation-corpus.mjs",
    "eval:dj": "npm run build && node dist/test/evaluate.js --refs tests/ground-truth --audio samples",
    "offset-test": "npm run build && node dist/test/offset-test.js",
    "smoke:library": "npm run build && node scripts/smoke-library.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.8.15",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "essentia.js": "^0.1.3",
    "ffmpeg-static": "^5.2.0",
    "fft.js": "4.0.4",
    "music-metadata": "^12.5.0",
    "onnxruntime-node": "1.23.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.cuekoda.app",
    "productName": "CueKoda",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/test/**",
      "!dist/renderer/preview*",
      "package.json",
      "models/**/*",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "asarUnpack": [
      "node_modules/@tensorflow/tfjs-backend-wasm/**",
      "node_modules/onnxruntime-node/bin/**",
      "models/**"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "files": [
        "!src{,/**/*}",
        "!scripts{,/**/*}",
        "!tests{,/**/*}",
        "!docs{,/**/*}",
        "!site{,/**/*}",
        "!assets{,/**/*}",
        "!vendor{,/**/*}",
        "!dist/test{,/**/*}",
        "!dist/**/*.map",
        "!*.md",
        "!node_modules/onnxruntime-node/bin/napi-v6/{linux,win32}/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/!(${arch})/**"
      ],
      "extraResources": [
        {
          "from": "vendor/ffmpeg/darwin-${arch}",
          "to": "ffmpeg"
        }
      ],
      "hardenedRuntime": false
    },
    "win": {
      "files": [
        "!src{,/**/*}",
        "!scripts{,/**/*}",
        "!tests{,/**/*}",
        "!docs{,/**/*}",
        "!site{,/**/*}",
        "!assets{,/**/*}",
        "!vendor{,/**/*}",
        "!dist/test{,/**/*}",
        "!dist/**/*.map",
        "!*.md",
        "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/!(${arch})/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/${arch}/{DirectML,dxcompiler,dxil}.dll"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "vendor/ffmpeg/win32-x64",
          "to": "ffmpeg"
        }
      ]
    },
    "dmg": {
      "artifactName": "CueKoda-${version}-mac-${arch}.${ext}",
      "title": "CueKoda ${version}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CueKoda",
      "artifactName": "CueKoda-${version}-windows-setup.${ext}"
    }
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true
  },
  "author": {
    "name": "Hadrien"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hadr1en/cuekoda.git"
  }
}
