{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CueKoda Tauri Experiment",
  "version": "0.1.0",
  "identifier": "com.cuekoda.experiment.tauri",
  "build": { "frontendDist": "../../dist/tauri" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "CueKoda · Tauri", "width": 1360, "height": 900 }],
    "security": {
      "capabilities": ["main"],
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": { "active": false, "icon": ["../../build/icon.png"] }
}
